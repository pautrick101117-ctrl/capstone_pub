NODE_ENV=development
PORT=4000
# Local client. In production use your exact Vercel origin.
CLIENT_URL=http://localhost:5173
# Optional comma-separated allow-list for preview + production Vercel domains.
CLIENT_URLS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
SUPABASE_URL=https://your-project.supabase.co
# SERVER ONLY. Never expose this key to Vite/browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=barangay-resident-ids
# Max wait for one Supabase HTTP request (not the total login flow).
SUPABASE_REQUEST_TIMEOUT_MS=12000
# Longer deadline for private images and Word document uploads.
SUPABASE_STORAGE_TIMEOUT_MS=60000

# Resend transactional email over HTTPS (works on Render Free web services).
# Create an API key in the Resend dashboard and keep it server-side only.
RESEND_API_KEY=replace-with-your-resend-api-key
# Sender must be an address under your verified Resend domain.
# Resend handles OUTBOUND email; domain ownership does not create an inbox.
RESEND_FROM_EMAIL=Barangay Iba <noreply@barangayiba.com>

# Maximum time to wait for the Resend HTTPS API before returning an email failure.
EMAIL_SEND_TIMEOUT_MS=12000
