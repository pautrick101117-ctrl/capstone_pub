NODE_ENV=development
PORT=4000
# Local client. In production use your exact Vercel origin.
CLIENT_URL=http://localhost:5173
# Optional comma-separated allow-list for preview + production Vercel domains.
CLIENT_URLS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
SUPABASE_URL=https://your-project.supabase.co
# SERVER ONLY. Never expose this key to Vite/browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=resident-valid-ids
GMAIL_APP_EMAIL=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Spaces pasted from Google App Password display are stripped automatically.
GMAIL_FROM_NAME=Barangay Iba

# Maximum time to wait for Gmail SMTP before returning a fallback response.
EMAIL_SEND_TIMEOUT_MS=12000
