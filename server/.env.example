NODE_ENV=development
PORT=4000
# Local client. In production use your exact Vercel origin.
CLIENT_URL=http://localhost:5173
# Optional comma-separated allow-list for preview + production Vercel domains.
CLIENT_URLS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
SUPABASE_URL=https://your-project.supabase.co
# SERVER ONLY. Never expose this key to Vite/browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=resident-valid-ids

# Resend transactional email over HTTPS (works on Render Free web services).
# Create an API key in the Resend dashboard and keep it server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# For initial Resend testing you can use onboarding@resend.dev, subject to your Resend account's test-recipient restrictions.
# For production, replace this with a sender on a domain you have verified in Resend.
RESEND_FROM_EMAIL=Barangay Iba <onboarding@resend.dev>

# Maximum time to wait for the Resend HTTPS API before returning an email failure.
EMAIL_SEND_TIMEOUT_MS=12000

